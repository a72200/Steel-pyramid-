<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المثلث الفولازي الهرمي - Steel Pyramid Wallet</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #0a0a1a 0%, #1a1a3e 50%, #0f0f2f 100%);
            min-height: 100vh;
            color: #fff;
            overflow-x: hidden;
        }
        
        .particles {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 0;
        }
        
        .particle {
            position: absolute;
            width: 3px; height: 3px;
            background: rgba(255, 215, 0, 0.6);
            border-radius: 50%;
            animation: float 6s infinite ease-in-out;
        }
        
        @keyframes float {
            0%, 100% { transform: translateY(0) scale(1); opacity: 0.3; }
            50% { transform: translateY(-100px) scale(1.5); opacity: 1; }
        }
        
        .container {
            position: relative;
            z-index: 1;
            max-width: 480px;
            margin: 0 auto;
            padding: 20px;
            min-height: 100vh;
        }
        
        .header {
            text-align: center;
            padding: 30px 0;
        }
        
        .logo {
            font-size: 28px;
            font-weight: bold;
            background: linear-gradient(45deg, #FFD700, #FFA500, #FF6347);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 30px rgba(255, 215, 0, 0.3);
            margin-bottom: 10px;
        }
        
        .subtitle {
            color: #a0a0c0;
            font-size: 14px;
            letter-spacing: 2px;
        }
        
        .pyramid-container {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 250px;
            margin: 20px 0;
            perspective: 800px;
        }
        
        .pyramid {
            width: 120px;
            height: 120px;
            position: relative;
            transform-style: preserve-3d;
            animation: rotatePyramid 8s infinite linear;
        }
        
        @keyframes rotatePyramid {
            0% { transform: rotateY(0deg) rotateX(15deg); }
            100% { transform: rotateY(360deg) rotateX(15deg); }
        }
        
        .pyramid-face {
            position: absolute;
            width: 0;
            height: 0;
            border-left: 60px solid transparent;
            border-right: 60px solid transparent;
            border-bottom: 104px solid;
            opacity: 0.7;
        }
        
        .face-front { 
            border-bottom-color: rgba(255, 215, 0, 0.8); 
            transform: translateZ(34px) rotateX(30deg);
        }
        .face-back { 
            border-bottom-color: rgba(255, 165, 0, 0.6); 
            transform: translateZ(-34px) rotateY(180deg) rotateX(30deg);
        }
        .face-left { 
            border-bottom-color: rgba(255, 140, 0, 0.6); 
            transform: translateX(-34px) rotateY(-90deg) rotateX(30deg);
        }
        .face-right { 
            border-bottom-color: rgba(218, 165, 32, 0.8); 
            transform: translateX(34px) rotateY(90deg) rotateX(30deg);
        }
        
        .pyramid-base {
            position: absolute;
            width: 120px;
            height: 120px;
            background: rgba(255, 215, 0, 0.2);
            transform: rotateX(90deg) translateZ(-60px);
            box-shadow: 0 0 50px rgba(255, 215, 0, 0.4);
        }
        
        .glow-ring {
            position: absolute;
            width: 200px;
            height: 200px;
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 50%;
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); opacity: 0.3; }
            50% { transform: scale(1.2); opacity: 0.8; }
        }
        
        .screen {
            display: none;
            animation: fadeIn 0.5s ease-in;
        }
        
        .screen.active {
            display: block;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 215, 0, 0.2);
            border-radius: 20px;
            padding: 25px;
            margin: 15px 0;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }
        
        .card-title {
            font-size: 18px;
            color: #FFD700;
            margin-bottom: 15px;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        
        .card-title .icon {
            font-size: 24px;
        }
        
        .input-group {
            margin: 15px 0;
        }
        
        .input-group label {
            display: block;
            color: #a0a0c0;
            font-size: 13px;
            margin-bottom: 8px;
        }
        
        .input-group input {
            width: 100%;
            padding: 15px;
            background: rgba(0, 0, 0, 0.3);
            border: 1px solid rgba(255, 215, 0, 0.3);
            border-radius: 12px;
            color: #fff;
            font-size: 16px;
            outline: none;
            transition: all 0.3s;
        }
        
        .input-group input:focus {
            border-color: #FFD700;
            box-shadow: 0 0 15px rgba(255, 215, 0, 0.2);
        }
        
        .btn {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #FFD700, #FFA500);
            border: none;
            border-radius: 12px;
            color: #1a1a3e;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin: 10px 0;
            transition: all 0.3s;
            box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
        }
        
        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(255, 215, 0, 0.5);
        }
        
        .btn-secondary {
            background: transparent;
            border: 2px solid rgba(255, 215, 0, 0.5);
            color: #FFD700;
        }
        
        .btn-secondary:hover {
            background: rgba(255, 215, 0, 0.1);
        }
        
        .pattern-area {
            width: 280px;
            height: 280px;
            margin: 20px auto;
            position: relative;
            background: rgba(0, 0, 0, 0.4);
            border: 2px solid rgba(255, 215, 0, 0.3);
            border-radius: 20px;
            overflow: hidden;
        }
        
        .pattern-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, 1fr);
            width: 100%;
            height: 100%;
            gap: 5px;
            padding: 20px;
        }
        
        .pattern-dot {
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
            color: rgba(255, 215, 0, 0.4);
            cursor: pointer;
            border-radius: 50%;
            transition: all 0.3s;
        }
        
        .pattern-dot:hover, .pattern-dot.active {
            color: #FFD700;
            text-shadow: 0 0 20px rgba(255, 215, 0, 0.8);
            transform: scale(1.3);
        }
        
        .pattern-dot.selected {
            color: #FF6347;
            text-shadow: 0 0 20px rgba(255, 99, 71, 0.8);
        }
        
        .status-bar {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin: 20px 0;
        }
        
        .status-dot {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.2);
            transition: all 0.3s;
        }
        
        .status-dot.active {
            background: #FFD700;
            box-shadow: 0 0 10px rgba(255, 215, 0, 0.8);
        }
        
        .status-dot.completed {
            background: #00FF88;
            box-shadow: 0 0 10px rgba(0, 255, 136, 0.8);
        }
        
        .layers-visual {
            display: flex;
            flex-direction: column;
            gap: 10px;
            margin: 20px 0;
        }
        
        .layer {
            display: flex;
            align-items: center;
            gap: 15px;
            padding: 15px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 12px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s;
        }
        
        .layer.active {
            border-color: #FFD700;
            background: rgba(255, 215, 0, 0.1);
        }
        
        .layer-icon {
            font-size: 28px;
        }
        
        .layer-info h4 {
            color: #FFD700;
            font-size: 14px;
        }
        
        .layer-info p {
            color: #a0a0c0;
            font-size: 12px;
        }
        
        .balance-card {
            background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(255, 165, 0, 0.1));
            border: 1px solid rgba(255, 215, 0, 0.4);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            margin: 20px 0;
        }
        
        .balance-label {
            color: #a0a0c0;
            font-size: 14px;
            letter-spacing: 2px;
        }
        
        .balance-amount {
            font-size: 42px;
            font-weight: bold;
            color: #FFD700;
            margin: 10px 0;
            text-shadow: 0 0 30px rgba(255, 215, 0, 0.5);
        }
        
        .balance-currency {
            color: #FFA500;
            font-size: 18px;
        }
        
        .transaction {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background: rgba(255, 255, 255, 0.03);
            border-radius: 12px;
            margin: 8px 0;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .transaction-icon {
            font-size: 24px;
        }
        
        .transaction-details h4 {
            color: #fff;
            font-size: 14px;
        }
        
        .transaction-details p {
            color: #a0a0c0;
            font-size: 12px;
        }
        
        .transaction-amount {
            font-weight: bold;
            font-size: 16px;
        }
        
        .transaction-amount.positive {
            color: #00FF88;
        }
        
        .transaction-amount.negative {
            color: #FF6347;
        }
        
        .progress-container {
            margin: 20px 0;
        }
        
        .progress-bar {
            height: 8px;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 10px;
            overflow: hidden;
        }
        
        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #FFD700, #FFA500);
            border-radius: 10px;
            transition: width 0.5s ease;
        }
        
        .toast {
            position: fixed;
            bottom: 30px;
            left: 50%;
            transform: translateX(-50%) translateY(100px);
            background: rgba(0, 0, 0, 0.9);
            color: #FFD700;
            padding: 15px 30px;
            border-radius: 12px;
            border: 1px solid rgba(255, 215, 0, 0.3);
            z-index: 1000;
            transition: transform 0.3s;
            font-size: 14px;
        }
        
        .toast.show {
            transform: translateX(-50%) translateY(0);
        }
        
        .loading {
            display: flex;
            justify-content: center;
            align-items: center;
            height: 200px;
        }
        
        .loading-spinner {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(255, 215, 0, 0.2);
            border-top-color: #FFD700;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        
        @media (max-width: 480px) {
            .container {
                padding: 15px;
            }
            
            .logo {
                font-size: 22px;
            }
            
            .pattern-area {
                width: 240px;
                height: 240px;
            }
        }
    </style>
</head>
<body>
    <div class="particles" id="particles"></div>
    
    <div class="container">
        <div class="header">
            <div class="logo">🔺 STEEL PYRAMID</div>
            <div class="subtitle">المثلث الفولازي الهرمي</div>
        </div>
        
        <div class="pyramid-container">
            <div class="glow-ring"></div>
            <div class="pyramid">
                <div class="pyramid-face face-front"></div>
                <div class="pyramid-face face-back"></div>
                <div class="pyramid-face face-left"></div>
                <div class="pyramid-face face-right"></div>
                <div class="pyramid-base"></div>
            </div>
        </div>
        
        <!-- Screen 1: Welcome -->
        <div class="screen active" id="screen-welcome">
            <div class="card">
                <div class="card-title">
                    <span class="icon">👁️</span>
                    محفظة العين الذكية
                </div>
                <p style="color: #a0a0c0; line-height: 1.8; margin-bottom: 20px;">
                    أول محفظة رقمية في العالم بمصادقة حركة العين. 
                    3 طبقات أمان + تشفير AES-256 + توثيق البنك المركزي.
                </p>
                
                <div class="layers-visual">
                    <div class="layer active">
                        <div class="layer-icon">🔐</div>
                        <div class="layer-info">
                            <h4>طبقة 1: كلمة المرور</h4>
                            <p>حماية أولية مشفرة</p>
                        </div>
                    </div>
                    <div class="layer">
                        <div class="layer-icon">📝</div>
                        <div class="layer-info">
                            <h4>طبقة 2: الجملة السرية</h4>
                            <p>عبارة استرداد خاصة</p>
                        </div>
                    </div>
                    <div class="layer">
                        <div class="layer-icon">👁️</div>
                        <div class="layer-info">
                            <h4>طبقة 3: نمط العين</h4>
                            <p>بصمة العين الفريدة</p>
                        </div>
                    </div>
                </div>
                
                <button class="btn" onclick="showScreen('screen-enroll')">🔐 إنشاء محفظة جديدة</button>
                <button class="btn btn-secondary" onclick="showScreen('screen-login')">👁️ الدخول بالعين</button>
            </div>
        </div>
        
        <!-- Screen 2: Enrollment - Password -->
        <div class="screen" id="screen-enroll">
            <div class="status-bar">
                <div class="status-dot active"></div>
                <div class="status-dot"></div>
                <div class="status-dot"></div>
                <div class="status-dot"></div>
            </div>
            
            <div class="card">
                <div class="card-title">
                    <span class="icon">🔐</span>
                    الطبقة الأولى: كلمة المرور
                </div>
                
                <div class="input-group">
                    <label>👤 اسم المستخدم</label>
                    <input type="text" id="username" placeholder="أدخل اسمك">
                </div>
                
                <div class="input-group">
                    <label>🔑 كلمة المرور</label>
                    <input type="password" id="password" placeholder="8 أحرف على الأقل">
                </div>
                
                <div class="input-group">
                    <label>🔑 تأكيد كلمة المرور</label>
                    <input type="password" id="password-confirm" placeholder="أعد إدخال كلمة المرور">
                </div>
                
                <button class="btn" onclick="nextEnrollStep(2)">التالي ⬅️</button>
                <button class="btn btn-secondary" onclick="showScreen('screen-welcome')">رجوع</button>
            </div>
        </div>
        
        <!-- Screen 3: Enrollment - Passphrase -->
        <div class="screen" id="screen-enroll-2">
            <div class="status-bar">
                <div class="status-dot completed"></div>
                <div class="status-dot active"></div>
                <div class="status-dot"></div>
                <div class="status-dot"></div>
            </div>
            
            <div class="card">
                <div class="card-title">
                    <span class="icon">📝</span>
                    الطبقة الثانية: الجملة السرية
                </div>
                
                <p style="color: #a0a0c0; margin-bottom: 15px;">
                    اكتب جملة سرية لا تنساها. تُستخدم لاسترداد المحفظة في حالات الطوارئ.
                </p>
                
                <div class="input-group">
                    <label>📝 الجملة السرية (Passphrase)</label>
                    <input type="text" id="passphrase" placeholder="مثال: أنا صاحب الهرم الذهبي 2026">
                </div>
                
                <div style="background: rgba(255, 215, 0, 0.1); border: 1px solid rgba(255, 215, 0, 0.3); border-radius: 10px; padding: 15px; margin: 15px 0;">
                    <p style="color: #FFD700; font-size: 13px;">
                        ⚠️ احفظي هذه الجملة في مكان آمن. لا يمكن استردادها إذا فقدتها!
                    </p>
                </div>
                
                <button class="btn" onclick="nextEnrollStep(3)">التالي ⬅️</button>
                <button class="btn btn-secondary" onclick="showScreen('screen-enroll')">رجوع</button>
            </div>
        </div>
        
        <!-- Screen 4: Enrollment - Eye Pattern -->
        <div class="screen" id="screen-enroll-3">
            <div class="status-bar">
                <div class="status-dot completed"></div>
                <div class="status-dot completed"></div>
                <div class="status-dot active"></div>
                <div class="status-dot"></div>
            </div>
            
            <div class="card">
                <div class="card-title">
                    <span class="icon">👁️</span>
                    الطبقة الثالثة: نمط حركة العين
                </div>
                
                <p style="color: #a0a0c0; margin-bottom: 15px; text-align: center;">
                    اضغط على النقاط بالترتيب لتسجيل نمطك السري
                </p>
                
                <div class="pattern-area">
                    <div class="pattern-grid" id="pattern-grid">
                        <div class="pattern-dot" data-pos="1">⬆️</div>
                        <div class="pattern-dot" data-pos="2">↗️</div>
                        <div class="pattern-dot" data-pos="3">➡️</div>
                        <div class="pattern-dot" data-pos="4">↘️</div>
                        <div class="pattern-dot" data-pos="5">⬇️</div>
                        <div class="pattern-dot" data-pos="6">↙️</div>
                        <div class="pattern-dot" data-pos="7">⬅️</div>
                        <div class="pattern-dot" data-pos="8">↖️</div>
                        <div class="pattern-dot" data-pos="9">⭐</div>
                    </div>
                </div>
                
                <div style="text-align: center; color: #a0a0c0; font-size: 13px; margin: 10px 0;">
                    <span id="pattern-status">اضغط 4 نقاط على الأقل</span>
                </div>
                
                <button class="btn" id="btn-pattern-next" onclick="nextEnrollStep(4)" disabled>التالي ⬅️</button>
                <button class="btn btn-secondary" onclick="resetPattern()">🔄 إعادة</button>
            </div>
        </div>
        
        <!-- Screen 5: Enrollment - PIN Code -->
        <div class="screen" id="screen-enroll-4">
            <div class="status-bar">
                <div class="status-dot completed"></div>
                <div class="status-dot completed"></div>
                <div class="status-dot completed"></div>
                <div class="status-dot active"></div>
            </div>
            
            <div class="card">
                <div class="card-title">
                    <span class="icon">🔢</span>
                    الرمز الرقمي (6 أرقام)
                </div>
                
                <p style="color: #a0a0c0; margin-bottom: 15px;">
                    رمز سري للطوارئ والتحقق السريع
                </p>
                
                <div class="input-group">
                    <label>🔢 الرقم السري (6 أرقام)</label>
                    <input type="password" id="pin-code" maxlength="6" placeholder="123456" inputmode="numeric">
                </div>
                
                <div class="input-group">
                    <label>🔢 تأكيد الرقم</label>
                    <input type="password" id="pin-confirm" maxlength="6" placeholder="123456" inputmode="numeric">
                </div>
                
                <button class="btn" onclick="completeEnrollment()">✅ إنشاء المحفظة</button>
                <button class="btn btn-secondary" onclick="showScreen('screen-enroll-3')">رجوع</button>
            </div>
        </div>
        
        <!-- Screen 6: Loading -->
        <div class="screen" id="screen-loading">
            <div class="loading">
                <div class="loading-spinner"></div>
            </div>
            <p style="text-align: center; color: #FFD700; margin-top: 20px;">
                جاري التشفير وإنشاء المحفظة...
            </p>
            <div class="progress-container" style="max-width: 300px; margin: 20px auto;">
                <div class="progress-bar">
                    <div class="progress-fill" id="progress-fill" style="width: 0%"></div>
                </div>
            </div>
        </div>
        
        <!-- Screen 7: Wallet Dashboard -->
        <div class="screen" id="screen-wallet">
            <div class="header" style="padding: 15px 0;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-size: 12px; color: #a0a0c0;">مرحباً، <span id="wallet-username">المستخدم</span></div>
                        <div style="font-size: 10px; color: #00FF88;">✅ موثق بالبنك المركزي</div>
                    </div>
                    <div style="font-size: 24px;">👁️</div>
                </div>
            </div>
            
            <div class="balance-card">
                <div class="balance-label">الرصيد المتاح</div>
                <div class="balance-amount" id="balance">10,000.00</div>
                <div class="balance-currency">جنيه مصري (EGP)</div>
            </div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 15px 0;">
                <button class="btn" style="font-size: 14px;">📤 إرسال</button>
                <button class="btn" style="font-size: 14px;">📥 استقبال</button>
            </div>
            
            <div class="card">
                <div class="card-title">
                    <span class="icon">📋</span>
                    آخر المعاملات
                </div>
                
                <div class="transaction">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div class="transaction-icon">🏪</div>
                        <div class="transaction-details">
                            <h4>محل البقالة</h4>
                            <p>اليوم 14:30</p>
                        </div>
                    </div>
                    <div class="transaction-amount negative">-250.00</div>
                </div>
                
                <div class="transaction">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div class="transaction-icon">💰</div>
                        <div class="transaction-details">
                            <h4>إيداع - البنك الأهلي</h4>
                            <p>أمس 10:15</p>
                        </div>
                    </div>
                    <div class="transaction-amount positive">+5,000.00</div>
                </div>
                
                <div class="transaction">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div class="transaction-icon">🛒</div>
                        <div class="transaction-details">
                            <h4>متجر إلكتروني</h4>
                            <p>22 مايو 2026</p>
                        </div>
                    </div>
                    <div class="transaction-amount negative">-1,200.00</div>
                </div>
            </div>
            
            <div class="card">
                <div class="card-title">
                    <span class="icon">🛡️</span>
                    حالة الأمان
                </div>
                <div class="layers-visual">
                    <div class="layer active">
                        <div class="layer-icon">✅</div>
                        <div class="layer-info">
                            <h4>كلمة المرور</h4>
                            <p>نشطة ومشفرة</p>
                        </div>
                    </div>
                    <div class="layer active">
                        <div class="layer-icon">✅</div>
                        <div class="layer-info">
                            <h4>الجملة السرية</h4>
                            <p>محفوظة بأمان</p>
                        </div>
                    </div>
                    <div class="layer active">
                        <div class="layer-icon">✅</div>
                        <div class="layer-info">
                            <h4>نمط العين</h4>
                            <p>مسجل ومفعل</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <button class="btn btn-secondary" onclick="logout()">🚪 تسجيل الخروج</button>
        </div>
        
        <!-- Screen 8: Login with Eye Pattern -->
        <div class="screen" id="screen-login">
            <div class="card">
                <div class="card-title">
                    <span class="icon">👁️</span>
                    الدخول السريع بالعين
                </div>
                
                <p style="color: #a0a0c0; margin-bottom: 15px; text-align: center;">
                    اضغط على النقاط بالترتيب السري
                </p>
                
                <div class="pattern-area">
                    <div class="pattern-grid" id="login-pattern-grid">
                        <div class="pattern-dot" data-pos="1">⬆️</div>
                        <div class="pattern-dot" data-pos="2">↗️</div>
                        <div class="pattern-dot" data-pos="3">➡️</div>
                        <div class="pattern-dot" data-pos="4">↘️</div>
                        <div class="pattern-dot" data-pos="5">⬇️</div>
                        <div class="pattern-dot" data-pos="6">↙️</div>
                        <div class="pattern-dot" data-pos="7">⬅️</div>
                        <div class="pattern-dot" data-pos="8">↖️</div>
                        <div class="pattern-dot" data-pos="9">⭐</div>
                    </div>
                </div>
                
                <div style="text-align: center; color: #a0a0c0; font-size: 13px; margin: 10px 0;">
                    <span id="login-status">أدخل نمطك السري</span>
                </div>
                
                <button class="btn" id="btn-login-eye" onclick="verifyEyePattern()" disabled>🔓 فتح المحفظة</button>
                <button class="btn btn-secondary" onclick="showScreen('screen-login-fallback')">🔐 الدخول بالرقم السري</button>
                <button class="btn btn-secondary" onclick="showScreen('screen-welcome')">رجوع</button>
            </div>
        </div>
        
        <!-- Screen 9: Login Fallback (PIN) -->
        <div class="screen" id="screen-login-fallback">
            <div class="card">
                <div class="card-title">
                    <span class="icon">🔢</span>
                    الدخول بالرقم السري
                </div>
                
                <div class="input-group">
                    <label>👤 اسم المستخدم</label>
                    <input type="text" id="login-username" placeholder="اسم المستخدم">
                </div>
                
                <div class="input-group">
                    <label>🔢 الرقم السري (6 أرقام)</label>
                    <input type="password" id="login-pin" maxlength="6" placeholder="123456" inputmode="numeric">
                </div>
                
                <button class="btn" onclick="loginWithPin()">🔓 دخول</button>
                <button class="btn btn-secondary" onclick="showScreen('screen-login')">👁️ الدخول بالعين</button>
                <button class="btn btn-secondary" onclick="showScreen('screen-welcome')">رجوع</button>
            </div>
        </div>
    </div>
    
    <div class="toast" id="toast"></div>
    
    <script>
        let currentPattern = [];
        let savedPattern = [];
        let userData = {};
        
        function createParticles() {
            const container = document.getElementById('particles');
            for (let i = 0; i < 30; i++) {
                const particle = document.createElement('div');
                particle.className = 'particle';
                particle.style.left = Math.random() * 100 + '%';
                particle.style.top = Math.random() * 100 + '%';
                particle.style.animationDelay = Math.random() * 6 + 's';
                particle.style.animationDuration = (4 + Math.random() * 4) + 's';
                container.appendChild(particle);
            }
        }
        
        function showToast(message) {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3000);
        }
        
        function showScreen(screenId) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            document.getElementById(screenId).classList.add('active');
        }
        
        function nextEnrollStep(step) {
            if (step === 2) {
                const pass = document.getElementById('password').value;
                const confirm = document.getElementById('password-confirm').value;
                const username = document.getElementById('username').value;
                
                if (!username || !pass || pass !== confirm || pass.length < 8) {
                    showToast('❌ تأكد من إدخال جميع البيانات بشكل صحيح');
                    return;
                }
                userData.username = username;
                userData.password = pass;
                showScreen('screen-enroll-2');
            }
            else if (step === 3) {
                const passphrase = document.getElementById('passphrase').value;
                if (!passphrase || passphrase.length < 10) {
                    showToast('❌ الجملة السرية يجب أن تكون 10 أحرف على الأقل');
                    return;
                }
                userData.passphrase = passphrase;
                showScreen('screen-enroll-3');
                initPatternGrid();
            }
            else if (step === 4) {
                if (currentPattern.length < 4) {
                    showToast('❌ اختر 4 نقاط على الأقل');
                    return;
                }
                savedPattern = [...currentPattern];
                userData.pattern = savedPattern;
                showScreen('screen-enroll-4');
            }
        }
        
        function initPatternGrid() {
            currentPattern = [];
            document.getElementById('pattern-status').textContent = 'اضغط 4 نقاط على الأقل';
            document.getElementById('btn-pattern-next').disabled = true;
            
            document.querySelectorAll('#pattern-grid .pattern-dot').forEach(dot => {
                dot.classList.remove('selected');
                dot.onclick = function() {
                    const pos = this.getAttribute('data-pos');
                    if (!currentPattern.includes(pos)) {
                        currentPattern.push(pos);
                        this.classList.add('selected');
                        document.getElementById('pattern-status').textContent = 
                            'تم اختيار ' + currentPattern.length + ' نقطة';
                        if (currentPattern.length >= 4) {
                            document.getElementById('btn-pattern-next').disabled = false;
                        }
                    }
                };
            });
        }
        
        function resetPattern() {
            currentPattern = [];
            document.querySelectorAll('#pattern-grid .pattern-dot').forEach(dot => {
                dot.classList.remove('selected');
            });
            document.getElementById('pattern-status').textContent = 'اضغط 4 نقاط على الأقل';
            document.getElementById('btn-pattern-next').disabled = true;
        }
        
        function completeEnrollment() {
            const pin = document.getElementById('pin-code').value;
            const confirm = document.getElementById('pin-confirm').value;
            
            if (!pin || pin !== confirm || pin.length !== 6) {
                showToast('❌ تأكد من إدخال رقم سري صحيح (6 أرقام)');
                return;
            }
            
            userData.pin = pin;
            localStorage.setItem('steelPyramidUser', JSON.stringify(userData));
            
            showScreen('screen-loading');
            
            let progress = 0;
            const interval = setInterval(() => {
                progress += 10;
                document.getElementById('progress-fill').style.width = progress + '%';
                if (progress >= 100) {
                    clearInterval(interval);
                    showToast('✅ تم إنشاء المحفظة بنجاح!');
                    setTimeout(() => {
                        document.getElementById('wallet-username').textContent = userData.username;
                        showScreen('screen-wallet');
                    }, 500);
                }
            }, 200);
        }
        
        let loginPattern = [];
        
        function initLoginPattern() {
            loginPattern = [];
            document.getElementById('login-status').textContent = 'أدخل نمطك السري';
            document.getElementById('btn-login-eye').disabled = true;
            
            document.querySelectorAll('#login-pattern-grid .pattern-dot').forEach(dot => {
                dot.classList.remove('selected');
                dot.onclick = function() {
                    const pos = this.getAttribute('data-pos');
                    if (!loginPattern.includes(pos)) {
                        loginPattern.push(pos);
                        this.classList.add('selected');
                        document.getElementById('login-status').textContent = 
                            'تم ' + loginPattern.length + ' نقطة';
                        if (loginPattern.length >= 4) {
                            document.getElementById('btn-login-eye').disabled = false;
                        }
                    }
                };
            });
        }
        
        function verifyEyePattern() {
            const saved = JSON.parse(localStorage.getItem('steelPyramidUser') || '{}');
            
            if (!saved.pattern) {
                showToast('❌ لا يوجد حساب مسجل');
                return;
            }
            
            const match = JSON.stringify(loginPattern) === JSON.stringify(saved.pattern);
            
            if (match) {
                showToast('✅ تم التحقق بنجاح!');
                document.getElementById('wallet-username').textContent = saved.username;
                setTimeout(() => showScreen('screen-wallet'), 500);
            } else {
                showToast('❌ النمط غير صحيح. حاول مرة أخرى');
                loginPattern = [];
                document.querySelectorAll('#login-pattern-grid .pattern-dot').forEach(dot => {
                    dot.classList.remove('selected');
                });
                document.getElementById('login-status').textContent = 'أدخل نمطك السري';
                document.getElementById('btn-login-eye').disabled = true;
            }
        }
        
        function loginWithPin() {
            const username = document.getElementById('login-username').value;
            const pin = document.getElementById('login-pin').value;
            const saved = JSON.parse(localStorage.getItem('steelPyramidUser') || '{}');
            
            if (saved.username === username && saved.pin === pin) {
                showToast('✅ تم الدخول بنجاح!');
                document.getElementById('wallet-username').textContent = saved.username;
                setTimeout(() => showScreen('screen-wallet'), 500);
            } else {
                showToast('❌ بيانات الدخول غير صحيحة');
            }
        }
        
        function logout() {
            showToast('👋 تم تسجيل الخروج');
            setTimeout(() => showScreen('screen-welcome'), 500);
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            createParticles();
            initPatternGrid();
            initLoginPattern();
        });
    </script>
</body>
</html>
